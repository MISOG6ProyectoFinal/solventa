{
  "info": {
    "name": "Solventa recorrido Canales",
    "description": "Recorrido funcional de los tres canales de Canales (móvil, portal web y API de socios) para Postman o Newman. Cada iteración crea un cliente, un aviso de siniestro radicado y una evidencia. Las peticiones móviles autenticadas usan el token que guarda Iniciar sesión. La API de socios necesita socioId, socioClientId y socioSecreto de un socio con el ramo de viaje habilitado. La subida de evidencia lee load-tests/fixtures/evidencia.png, así que Newman se ejecuta desde apps/backend. La prueba de carga está en load-tests/canales.js con k6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dzwq94g5om86y.cloudfront.net"
    },
    {
      "key": "productoId",
      "value": "viaje-internacional"
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "contrasena",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "avisoId",
      "value": ""
    },
    {
      "key": "radicado",
      "value": ""
    },
    {
      "key": "evidenciaId",
      "value": ""
    },
    {
      "key": "uploadUrl",
      "value": ""
    },
    {
      "key": "evidenciaBytes",
      "value": "69"
    },
    {
      "key": "socioId",
      "value": ""
    },
    {
      "key": "socioClientId",
      "value": ""
    },
    {
      "key": "socioSecreto",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Móvil",
      "description": "Recorrido del cliente en la app: registro e inicio de sesión y, con el token, consulta de sesión, catálogo, cotización, reporte de siniestro con evidencia, radicación y listado de avisos.",
      "item": [
        {
          "name": "BFF móvil disponible",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/movil/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Canales responde', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/movil/registros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"nombre\": \"Prueba\",\n  \"apellido\": \"Carga\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufijo = Date.now() + '-' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('correo', 'carga-' + sufijo + '@solventa.test');",
                  "pm.collectionVariables.set('contrasena', pm.variables.replaceIn('{{$randomPassword}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuenta = pm.response.json();",
                  "pm.test('La cuenta queda creada y con sesión', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(cuenta.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/movil/sesiones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sesion = pm.response.json();",
                  "pm.test('La sesión entrega un token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(sesion.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('token', sesion.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sesión",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/movil/sesion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La sesión corresponde al cliente', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().correo).to.eql(pm.collectionVariables.get('correo'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo de productos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/movil/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const productos = pm.response.json();",
                  "pm.test('El catálogo trae productos', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(productos).to.be.an('array').that.is.not.empty;",
                  "});",
                  "const viaje = productos.find((p) => p.id === pm.collectionVariables.get('productoId'));",
                  "pm.test('El producto de viaje está disponible', function () {",
                  "  pm.expect(viaje, 'producto ' + pm.collectionVariables.get('productoId')).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cotizar desde el móvil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/movil/cotizaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": \"{{productoId}}\",\n  \"nombre\": \"Prueba Carga\",\n  \"cedula\": \"{{cedula}}\",\n  \"destino\": \"España\",\n  \"fecha_salida\": \"{{fechaSalida}}\",\n  \"fecha_regreso\": \"{{fechaRegreso}}\",\n  \"viajeros\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dia = (desplazamiento) => {",
                  "  const fecha = new Date();",
                  "  fecha.setDate(fecha.getDate() + desplazamiento);",
                  "  return fecha.toISOString().slice(0, 10);",
                  "};",
                  "pm.variables.set('fechaSalida', dia(30));",
                  "pm.variables.set('fechaRegreso', dia(40));",
                  "pm.variables.set('cedula', '1' + String(Date.now()).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const oferta = pm.response.json();",
                  "pm.test('El consenso devuelve una oferta', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(Number(oferta.prima)).to.be.above(0);",
                  "  pm.expect(oferta.coberturas).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reportar siniestro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/movil/siniestros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"poliza_id\": \"SLV-2026-03105\",\n  \"tipo\": \"Accidente con vehículo de alquiler\",\n  \"ocurrido_en\": \"{{ocurridoEn}}\",\n  \"descripcion\": \"Aviso generado por la prueba de carga\",\n  \"ubicacion\": \"Calle 85 #12-34, Chapinero, Bogotá\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ayer = new Date(Date.now() - 24 * 60 * 60 * 1000);",
                  "pm.variables.set('ocurridoEn', ayer.toISOString().slice(0, 19));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const aviso = pm.response.json();",
                  "pm.test('El aviso queda en borrador', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(aviso.estado).to.eql('borrador');",
                  "});",
                  "pm.collectionVariables.set('avisoId', aviso.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitar carga de evidencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/movil/siniestros/{{avisoId}}/evidencias/cargas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"image/png\",\n  \"bytes\": \"{{evidenciaBytes}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const carga = pm.response.json();",
                  "pm.test('Devuelve la URL de carga', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(carga.upload_url).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('evidenciaId', carga.evidencia_id);",
                  "pm.collectionVariables.set('uploadUrl', carga.upload_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Subir evidencia",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/png"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": "load-tests/fixtures/evidencia.png"
              }
            },
            "url": "{{uploadUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El archivo queda guardado', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar evidencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/movil/siniestros/{{avisoId}}/evidencias/{{evidenciaId}}/confirmar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La evidencia queda disponible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().estado).to.eql('disponible');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar evidencias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/movil/siniestros/{{avisoId}}/evidencias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El aviso lista su evidencia', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Radicar siniestro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/movil/siniestros/{{avisoId}}/radicar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const aviso = pm.response.json();",
                  "pm.test('El aviso queda radicado', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(aviso.id).to.eql(pm.collectionVariables.get('avisoId'));",
                  "  pm.expect(aviso.estado).to.eql('radicado');",
                  "  pm.expect(aviso.radicado).to.match(/^SIN-\\d+$/);",
                  "});",
                  "pm.collectionVariables.set('radicado', aviso.radicado);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar siniestros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/movil/siniestros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const avisos = pm.response.json();",
                  "const aviso = avisos.find((a) => a.id === pm.collectionVariables.get('avisoId'));",
                  "pm.test('El cliente ve su aviso radicado', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(aviso, 'aviso ' + pm.collectionVariables.get('avisoId')).to.be.an('object');",
                  "  pm.expect(aviso.estado).to.eql('radicado');",
                  "  pm.expect(aviso.radicado).to.eql(pm.collectionVariables.get('radicado'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Portal web",
      "description": "Operación del back-office: cotización asistida y consulta de socios.",
      "item": [
        {
          "name": "Cotizar desde el portal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/web/cotizaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": \"{{productoId}}\",\n  \"destino\": \"España\",\n  \"fecha_salida\": \"{{fechaSalida}}\",\n  \"fecha_regreso\": \"{{fechaRegreso}}\",\n  \"viajeros\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dia = (desplazamiento) => {",
                  "  const fecha = new Date();",
                  "  fecha.setDate(fecha.getDate() + desplazamiento);",
                  "  return fecha.toISOString().slice(0, 10);",
                  "};",
                  "pm.variables.set('fechaSalida', dia(30));",
                  "pm.variables.set('fechaRegreso', dia(40));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const oferta = pm.response.json();",
                  "pm.test('El consenso devuelve una oferta', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(Number(oferta.prima)).to.be.above(0);",
                  "  pm.expect(oferta.coberturas).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar socios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/web/socios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El portal lista los socios', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle del socio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/web/socios/{{socioId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El portal muestra el socio', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.variables.get('socioId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Configuración del socio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/web/socios/{{socioId}}/configuracion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ramos = pm.response.json().ramos;",
                  "pm.test('El socio tiene el ramo de viaje habilitado', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(ramos.find((r) => r.id === 'ramo-viaje').habilitado).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "API de socios",
      "description": "Cotización embebida desde el canal de un socio (ASR-01 y ASR-04).",
      "item": [
        {
          "name": "Cotizar como socio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{socioClientId}}"
              },
              {
                "key": "X-Api-Key",
                "value": "{{socioSecreto}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/socios/v1/cotizaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": \"{{productoId}}\",\n  \"destino\": \"España\",\n  \"fecha_salida\": \"{{fechaSalida}}\",\n  \"fecha_regreso\": \"{{fechaRegreso}}\",\n  \"viajeros\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dia = (desplazamiento) => {",
                  "  const fecha = new Date();",
                  "  fecha.setDate(fecha.getDate() + desplazamiento);",
                  "  return fecha.toISOString().slice(0, 10);",
                  "};",
                  "pm.variables.set('fechaSalida', dia(30));",
                  "pm.variables.set('fechaRegreso', dia(40));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const oferta = pm.response.json();",
                  "pm.test('El consenso devuelve una oferta', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(Number(oferta.prima)).to.be.above(0);",
                  "  pm.expect(oferta.coberturas).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(oferta.degradada).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cotizar como socio sin un dato obligatorio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Client-Id",
                "value": "{{socioClientId}}"
              },
              {
                "key": "X-Api-Key",
                "value": "{{socioSecreto}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/socios/v1/cotizaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": \"{{productoId}}\",\n  \"destino\": \"España\",\n  \"viajeros\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const error = pm.response.json().detail;",
                  "pm.test('El contrato explica cada campo y no calcula', function () {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(error.codigo).to.equal('datos_invalidos');",
                  "  pm.expect(error.campos.map((c) => c.campo)).to.include.members(['fecha_salida', 'fecha_regreso']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
