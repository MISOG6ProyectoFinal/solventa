        <mxCell id="TNzd29hDDQF3IUUpgZvC-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;fontSize=11;" value="&lt;div style=&quot;text-align:left;padding:6px 8px;line-height:1.45;font-size:10.5px;&quot;&gt;&lt;b&gt;Cubo «node» / «execution environment»&lt;/b&gt;: nodo de ejecucion (UML 2.0).&lt;br/&gt;&lt;b&gt;Cilindro verde&lt;/b&gt;: almacen de datos.&lt;br/&gt;&lt;b&gt;«artifact» amarillo&lt;/b&gt;: artefacto desplegado (manifiesta un componente del Modelo de Componentes).&lt;br/&gt;&lt;br/&gt;&lt;u&gt;Tipos de conector:&lt;/u&gt;&lt;br/&gt;&lt;b&gt;Flecha solida «communication path»&lt;/b&gt;: TCP/IP o HTTPS sincrono (borde de red, balanceador, gateway, clusteres).&lt;br/&gt;&lt;b&gt;Flecha discontinua dorada «heartbeat»&lt;/b&gt;: sondeo activo del Health Monitor (deteccion de fallas).&lt;br/&gt;&lt;b&gt;Flecha discontinua verde «replicate»&lt;/b&gt;: replicacion sincrona/asincrona entre nodos de BD.&lt;br/&gt;&lt;b&gt;Flecha solida con etiqueta HTTPS+timeout&lt;/b&gt;: comunicacion protegida con circuit breaker hacia terceros.&lt;br/&gt;&lt;br/&gt;Nube agnostica: los nodos describen capacidades, no productos.&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="420" x="1249" y="115" as="geometry" />
        </mxCell>
