        <mxCell id="cmpc1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;fontSize=11;" value="&lt;div style=&quot;text-align:left;padding:6px 8px;line-height:1.5;&quot;&gt;&lt;b&gt;Contenedor gris&lt;/b&gt;: capa lógica de la arquitectura.&lt;br/&gt;&lt;b&gt;«Component»&lt;/b&gt;: componente desplegable de la solución.&lt;br/&gt;&lt;b&gt;Línea&lt;/b&gt;: dependencia entre capas a través de una interfaz.&lt;br/&gt;Estilo: microservicios por capacidad de negocio, con&lt;br/&gt;comunicación asíncrona por eventos y un BFF por canal.&lt;/div&gt;" vertex="1">
