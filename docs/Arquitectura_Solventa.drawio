        <mxCell id="NGu3HRREC4CFcpTs9nb1-80" parent="NGu3HRREC4CFcpTs9nb1-79" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontStyle=1;fontSize=12;align=center;" value="Convención" vertex="1">
          <mxGeometry height="35" width="420" as="geometry" />
        </mxCell>
        <mxCell id="NGu3HRREC4CFcpTs9nb1-81" parent="NGu3HRREC4CFcpTs9nb1-79" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=left;fontSize=11;" value="&lt;div style=&quot;text-align:left;padding:6px 8px;line-height:1.45;font-size:10.5px;&quot;&gt;&lt;b&gt;Contenedor gris&lt;/b&gt;: capa logica de la arquitectura.&lt;br/&gt;&lt;b&gt;«Component»&lt;/b&gt;: componente desplegable (UML 2.0).&lt;br/&gt;&lt;b&gt;Cilindro&lt;/b&gt;: almacen de datos.&lt;br/&gt;&lt;br/&gt;&lt;u&gt;Tipos de conector (UML 2.0):&lt;/u&gt;&lt;br/&gt;&lt;b&gt;flecha abierta discontinua «access/route»&lt;/b&gt;: dependencia de uso entre capas.&lt;br/&gt;&lt;b&gt;flecha abierta continua «call»&lt;/b&gt;: asociacion de invocacion sincrona.&lt;br/&gt;&lt;b&gt;flecha discontinua naranja «publish/subscribe»&lt;/b&gt;: mensajeria asincrona via Bus de Eventos.&lt;br/&gt;&lt;b&gt;flecha discontinua verde «replicate»&lt;/b&gt;: replicacion sincrona BD primaria-replica.&lt;br/&gt;&lt;b&gt;flecha discontinua gris «persist»&lt;/b&gt;: dependencia hacia el almacen de datos.&lt;br/&gt;&lt;b&gt;diamante hueco (agregacion)&lt;/b&gt;: Circuit Breaker Global agrega cada adaptador externo.&lt;br/&gt;&lt;b&gt;bola-cuenco&lt;/b&gt;: interfaz provista/requerida (IRuteoCotizacion, Gateway-BFF Web).&lt;br/&gt;&lt;br/&gt;Estilo: microservicios por capacidad de negocio, con&lt;br/&gt;comunicacion asincrona por eventos y un BFF por canal.&lt;/div&gt;" vertex="1">
          <mxGeometry height="283" width="420" y="35" as="geometry" />
        </mxCell>
        <mxCell id="NGu3HRREC4CFcpTs9nb1-82" parent="1" style="html=1;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fontSize=11;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;spacingLeft=0;container=0;" value="&lt;b&gt;«Component»&lt;/b&gt;&lt;br/&gt;&lt;b&gt;API Gateway&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;TLS, WAF, cuotas, versionado, enrutamiento&lt;/span&gt;" vertex="1">
